# ── FlatMitra Environment Variables ─────────────────────
# Copy this file to .env.local and fill in the values.

# Resend API key — get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Owner email(s) — comma-separated, no spaces
# Both receive a notification on every waitlist signup
NOTIFY_EMAIL_TO=nishchaygupta54@gmail.com,palnikhil525@gmail.com

# Sending domain: mail.emitra.dev (must be verified in Resend)
# FROM addresses used:
#   no-reply@mail.emitra.dev  → owner notifications
#   hello@mail.emitra.dev     → user confirmations
